# Local MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room

# Set a random value of at least 32 characters. Use a different value in production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Get a key from Google AI Studio. Keep this value private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Only needed when the frontend is hosted on a different origin.
# For the single-origin Render deployment, leave this unset.
# CLIENT_ORIGIN=https://your-frontend.example.com

PORT=4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=8
